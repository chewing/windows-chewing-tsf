<?xml version="1.0" encoding="UTF-8"?>

<?include version.wxi?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Package Name="新酷音輸入法 (TSF)" Codepage="65001" Language="1028" Manufacturer="新酷音輸入法開發團隊" Version="$(var.Version)" UpgradeStrategy="majorUpgrade" UpgradeCode="8085e4ce-205d-4c44-9450-59ba34163b2a">
        <MajorUpgrade AllowDowngrades="yes" />
        <MediaTemplate CompressionLevel="mszip" EmbedCab="yes" />
        <Property Id="PROCESSOR_ARCHITECTURE" Secure="yes">
            <RegistrySearch Id="ProcessorArchitectureValue" Type="raw" Root="HKLM" Key="System\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" />
        </Property>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="新酷音輸入法 (TSF)" />
        </StandardDirectory>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER64" Name="ChewingTextService">
                <Directory Id="Dictionary" Name="Dictionary">
                    <File Id="dict.swkb.dat" Source="Dictionary\swkb.dat" />
                    <File Id="dict.symbols.dat" Source="Dictionary\symbols.dat" />
                    <File Id="dict.static_dict.bin" Source="Dictionary\static_dict.bin" />
                    <File Id="dict.rare_dict.bin" Source="Dictionary\rare_dict.bin" />
                    <File Id="dict.static_words.bin" Source="Dictionary\static_words.bin" />
                    <File Id="dict.static_lm.bin" Source="Dictionary\static_lm.bin" />
                </Directory>
                <Component>
                    <File Id="ChewingPreferences.exe" Source="ChewingPreferences.exe" KeyPath="yes">
                        <Shortcut Advertise="yes" Icon="icon.exe" Name="設定新酷音輸入法" Directory="ApplicationProgramsFolder" />
                    </File>
                    <RemoveFolder Directory="ApplicationProgramsFolder" On="uninstall" />
                </Component>
                <Component>
                    <File Id="ChewingEditor.exe" Source="chewing-editor.exe" KeyPath="yes">
                        <Shortcut Advertise="yes" Icon="icon.exe" Name="編輯使用者詞庫" Directory="ApplicationProgramsFolder" />
                    </File>
                </Component>
                <Component>
                    <File Id="tsfreg.exe" Source="tsfreg.exe" />
                </Component>
                <File Id="WebView2Loader.dll" Source="WebView2Loader.dll" />
                <File Id="chewing_cli.exe" Source="chewing-cli.exe" />
                <File Id="chewing.ico" Source="chewing.ico" />
                <File Id="version.json" Source="version.json" />
                <Component >
                    <!-- Main protocol key -->
                    <RegistryKey Root="HKCR" Key="chewing-preferences">
                        <RegistryValue Type="string" Value="URL:Chewing Preferences" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <!-- Default icon -->
                    <RegistryKey Root="HKCR" Key="chewing-preferences\DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER64]ChewingPreferences.exe,0" />
                    </RegistryKey>
                    <!-- Shell command -->
                    <RegistryKey Root="HKCR" Key="chewing-preferences\shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER64]ChewingPreferences.exe&quot; &quot;%1&quot;" />
                    </RegistryKey>
                    <!-- Main protocol key -->
                    <RegistryKey Root="HKCR" Key="chewing-editor">
                        <RegistryValue Type="string" Value="URL:Chewing Editor" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <!-- Default icon -->
                    <RegistryKey Root="HKCR" Key="chewing-editor\DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER64]chewing-editor.exe,0" />
                    </RegistryKey>
                    <!-- Shell command -->
                    <RegistryKey Root="HKCR" Key="chewing-editor\shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER64]chewing-editor.exe&quot; &quot;%1&quot;" />
                    </RegistryKey>
                    <!-- To keep backward compatiable -->
                    <!-- Main protocol key -->
                    <RegistryKey Root="HKCR" Key="chewing-update-svc">
                        <RegistryValue Type="string" Value="URL:Chewing Update Service" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <!-- Default icon -->
                    <RegistryKey Root="HKCR" Key="chewing-update-svc\DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER64]chewing_tip_host.exe,0" />
                    </RegistryKey>
                    <!-- Shell command -->
                    <RegistryKey Root="HKCR" Key="chewing-update-svc\shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER64]chewing_tip_host.exe&quot; &quot;%1&quot;" />
                    </RegistryKey>
                    <!-- Main protocol key -->
                    <RegistryKey Root="HKCR" Key="chewing-tip-host">
                        <RegistryValue Type="string" Value="URL:Chewing TIP Host" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <!-- Default icon -->
                    <RegistryKey Root="HKCR" Key="chewing-tip-host\DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER64]chewing_tip_host.exe,0" />
                    </RegistryKey>
                    <!-- Shell command -->
                    <RegistryKey Root="HKCR" Key="chewing-tip-host\shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER64]chewing_tip_host.exe&quot; &quot;%1&quot;" />
                    </RegistryKey>
                </Component>
            </Directory>
        </StandardDirectory>
        <StandardDirectory Id="System64Folder">
            <Component >
                <File Id="x64.chewing_tip.dll" Source="x64\chewing_tip.dll" Name="chewing_tip_$(var.VersionSuffix).dll" />
            </Component>
            <Component >
                <File Id="x64.chewing_tip_arm64.dll" Source="x64\chewing_tip_arm64.dll"  Name="chewing_tip_arm64_$(var.VersionSuffix).dll" />
            </Component>
            <Component >
                <File Id="x64.chewing_tip_x64.dll" Source="x64\chewing_tip_x64.dll"  Name="chewing_tip_x64_$(var.VersionSuffix).dll" />
            </Component>
            <Component Guid="fd558430-35f7-49b5-8408-b42befcb4f32" Id="ServerChewingTipX64" Condition="PROCESSOR_ARCHITECTURE = &quot;AMD64&quot;">
                <Class Advertise="no" Context="InprocServer32" Description="新酷音輸入法 (TSF)" Id="13F2EF08-575C-4D8C-88E0-F67BB8052B84" IconIndex="0" ThreadingModel="apartment" Server="x64.chewing_tip_x64.dll" />
            </Component>
            <Component Guid="010d3ae4-e059-4dbd-be9a-411548e8f869" Id="ServerChewingTipArm64X" Condition="PROCESSOR_ARCHITECTURE = &quot;ARM64&quot;">
                <Class Advertise="no" Context="InprocServer32" Description="新酷音輸入法 (TSF)" Id="13F2EF08-575C-4D8C-88E0-F67BB8052B84" IconIndex="0" ThreadingModel="apartment" Server="x64.chewing_tip.dll" />
            </Component>
        </StandardDirectory>
        <StandardDirectory Id="SystemFolder">
            <Component Bitness="always32">
                <File Id="x86.chewing_tip.dll" Source="x86\chewing_tip.dll" Name="chewing_tip_$(var.VersionSuffix).dll">
                    <Class Advertise="no" Context="InprocServer32" Description="新酷音輸入法 (TSF)" Id="13F2EF08-575C-4D8C-88E0-F67BB8052B84" IconIndex="0" ThreadingModel="apartment" />
                </File>
            </Component>
        </StandardDirectory>
        <Icon Id="icon.exe" SourceFile="chewing.ico" />
        <CustomAction Id="RegisterTSF" FileRef="tsfreg.exe" ExeCommand="-r &quot;[INSTALLFOLDER64]chewing.ico&quot;" Impersonate="no" Execute="deferred" Return="check" />
        <CustomAction Id="UnregisterTSF" FileRef="tsfreg.exe" ExeCommand="-u" Impersonate="no" Execute="deferred" Return="check" />
        <CustomAction Id="EnableTIP" FileRef="tsfreg.exe" ExeCommand="-i" Impersonate="yes" Execute="deferred" Return="check" />
        <CustomAction Id="DisableTIP" FileRef="tsfreg.exe" ExeCommand="-d" Impersonate="yes" Execute="deferred" Return="check" />
        <InstallExecuteSequence>
            <Custom Action="RegisterTSF" After="WriteRegistryValues" Condition="Installed=&quot;&quot; AND PREVIOUSVERSIONSINSTALLED=&quot;&quot;" />
            <Custom Action="EnableTIP" After="RegisterTSF" Condition="Installed=&quot;&quot; AND PREVIOUSVERSIONSINSTALLED=&quot;&quot;" />
            <Custom Action="UnregisterTSF" Before="RemoveRegistryValues" Condition="PREVIOUSVERSIONSINSTALLED=&quot;&quot; AND REMOVE=&quot;ALL&quot;" />
            <Custom Action="DisableTIP" Before="UnregisterTSF" Condition="PREVIOUSVERSIONSINSTALLED=&quot;&quot; AND REMOVE=&quot;ALL&quot;" />
        </InstallExecuteSequence>
    </Package>
</Wix>
